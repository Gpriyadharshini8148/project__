# ===================================================================
# SFDC POS Playwright Framework - Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git (it contains sensitive credentials)
# ===================================================================

# ===== Excel Test Data Configuration =====
# Specify which test suite from TestData.xlsx to use
# Available suites: TC_01_E2E_SanityUIFlow, TC_02_AdminApproval, etc.
EXCEL_SUITE_NAME=TC_01_E2E_SanityUIFlow

# ===== Playwright Speed Control =====
# SLOW_MO: Delay between actions in milliseconds
# - 0 = Fast (for regression/CI)
# - 500 = Normal (default, good for development)
# - 1000 = Slow (for demos and watching tests)
SLOW_MO=500

# HEADLESS: Run tests without browser window
# - true = No browser window (faster, for CI)
# - false = Show browser window (for development)
HEADLESS=false

# ===== FOS (Customer) Login Credentials =====
FOS_URL=https://bajaj4--n2ppos.sandbox.my.site.com/dealercommunityreinvent/s/login/
FOS_USERNAME=your-fos-username@example.com
FOS_PASSWORD=your-fos-password

# ===== Admin Login Credentials =====
ADMIN_URL=https://bajaj4--n2ppos.sandbox.my.salesforce.com
ADMIN_USERNAME=your-admin-username@example.com
ADMIN_PASSWORD=your-admin-password

# ===== Environment Selection =====
# Which environment to test against
ENVIRONMENT=PREPROD
# Options: DEV, QA, UAT, PREPROD, PROD

# ===== Test Execution Settings =====
# Maximum time for a single test (milliseconds)
TEST_TIMEOUT=300000

# Maximum time for page navigation (milliseconds)
NAVIGATION_TIMEOUT=60000

# Number of retry attempts on failure
RETRY_COUNT=0

# ===== Optional: API Configuration =====
# Add your API endpoints if needed
API_BASE_URL=https://api.example.com
API_KEY=your-api-key-here

# ===== Optional: Reporting Configuration =====
# Report title
REPORT_TITLE=SFDC POS Test Results

# ===== Notes =====
# 1. After copying to .env, replace all placeholder values
# 2. Never commit .env to version control
# 3. Update this .env.example when adding new variables
# 4. Contact your team lead for actual credentials
